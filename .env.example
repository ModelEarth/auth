# Origin of the sign-in API (/api/auth, /api/oauth). Leave unset in
# production: the CloudRoot Worker serves these pages at /auth/ and the API
# at /api/ on the same origin.
#
# For `pnpm dev` (port 3000), point it at a server that runs the API, with
# this app's origin allowed for credentialed requests:
#   chat's server:           http://localhost:3700
#   the Worker (wrangler):   http://localhost:8787
# NEXT_PUBLIC_AUTH_API_URL=http://localhost:3700
