# Origin of chat's existing BetterAuth instance. This app has no auth
# backend of its own — the auth client, the OAuth sign-in redirect, and the
# db-status check all call this origin's /api/auth and /api/oauth routes
# over HTTP. Must be reachable from the browser, and chat's CORS config
# (next.config.mjs) must allow this app's origin with credentials for
# sign-in/sign-up/session calls to succeed.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3700
